 ],
 "poems": [
  {
   "seq": "1",
   "text": "あまつ空霞のうへは出る日の飛かりも両よし春や立らん",
   "kana": "",
   "speaker": "権大僧都尭孝一",
   "page": 1,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "",
   "kotobagaki": "延徳三年九月十五日立春"
  },
  {
   "seq": "2",
   "text": "和たの原行来もはたもしら波のたつをかき祭に霞春とな",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞",
   "kotobagaki": ""
  },
  {
   "seq": "3",
   "text": "これや此おさまれる世の声ならし見かきの竹に暮のかく",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鶯",
   "kotobagaki": ""
  },
  {
   "seq": "4",
   "text": "朝ほらけ山のいつこはみえわかて霞のひまに雪そ残れる",
   "kana": "",
   "speaker": "",
   "page": 1,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "残雪",
   "kotobagaki": ""
  },
  {
   "seq": "5",
   "text": "う地むれてけふや若なを柄そめん野への雪まのあ案きあらすも",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野若菜",
   "kotobagaki": ""
  },
  {
   "seq": "6",
   "text": "春は雨こたか里船かすけく梅のかけおつかしみすみやかれまし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "里梅",
   "kotobagaki": ""
  },
  {
   "seq": "7",
   "text": "さそへともうらみぬ風のやとりかな匂ひつきせぬ軒の梅か枝",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "管梅",
   "kotobagaki": ""
  },
  {
   "seq": "8",
   "text": "さえかへる霞の袖のうす水なをとけやしぬ月のかけかな",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春月",
   "kotobagaki": ""
  },
  {
   "seq": "9",
   "text": "霞のみ明ゆく夜はのひかりにて月ものこらす山のはせ出し",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春曙",
   "kotobagaki": ""
  },
  {
   "seq": "10",
   "text": "なきぬなり霞のをちの春のかり雨ななひかの行夕暮の空",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "帰雁",
   "kotobagaki": ""
  },
  {
   "seq": "11",
   "text": "ありまま山ありつる嶺ゟ見畳ぬまてかすむいなのゝ春まのゝて",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "春雨",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "おひくおりなきたる朝のあさ詠春の空さへ青柳のいと",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "柳",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "咲ぬやといそく心のはなかつら木するにかけぬ時のまもなし",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "侍花",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "かさしにもおらてことやたつせめのはつはつ花さくらさきまほふ也",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "初花",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "やとかりて春のいく夜をおしみきぬ月もおりしも花の下ふし",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "見花",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "とをからぬ嶺にやへるつしら雲にさかしらる山さくらかな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "盛花",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "木のもとにそ夏こし春の日数さへつも袖は花の雪となる色の",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落花",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "おもふ事いはぬ匂の花粉からたへすや色にいて廿ツ山ふき",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "款冬",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "住江の松の木陰に咲ぬしとしつ元をあらぬ波かとそみる",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "藤",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "なにをかもくれ行春に手向山桜のぬさはちり過にけせ",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮春",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "花の香を忍もちすり夏きても心もりぬる袖ならなくに",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "更衣",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "そことなき里の行手のうは木はらまたれぬ花のまさかり也",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "卯花",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "〽おりしきてこよひもあけぬ郭土なをやまつちの山のした菜",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "待郭公",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "ことなつるいかゝときゝし古ことも今はたれふほとゝきすかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関郭公",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "ゆたかなる水のまに〳〵七き入てもやすき世のさなへとからん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早留",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "橘にむかしの風のかほるともをよはぬ袖はいからふれさし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "早留",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "あま人の袖にも波はこゆるきのいその玉ものさ見たれのころ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋五月両",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "ほに出ぬ薄かられも露ちりて秋をそまねく野への夕風",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏草",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "秋よりこそ真砂の霜夜かけさえてつきに夏なき鐘のをとかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏月",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "ほのかなる光みるさへいとゝしく久らき夜川にかゝりさす也",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鵜川",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "かこつかな見地の光はちる世にも岩の蛍のおろかなる身を",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "蛍",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "〽蛍は日影そめくる山多かみはれぬ雲井や夕方の空",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夕立",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "かきすさむ蝉のは山の夕つく飛もるかけうすし木々の下左",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "塚",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "夏をさへしらぬおきなにむかふかなむまふ清水に影やうつれる",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "納涼",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "見そきする川世も成梨ぬみよしのやいつの宮人ゆふなかしけん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "夏抜",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "今朝よりく音もいはしかまかまかまとの尾上吹こす秋のは津風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋二十首初秋",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "遣ふにあま七夕つめつあまつひのふ祭はへ契る心しるしも",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "七夕",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "吹雨飛にきゝもすくさすかつと恨みかつはなくさむ萩のうは風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "物なへていさみにゆかんとはかりもたれかいはせの野へ其あき萩",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "萩",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "夕暮の秋ふく風に聞そへていとゝ身にしむ虫のうゑかな",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "虫虫",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "こしちより夜さむはさすかなれぬらん今更爰れに衣かりかね",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雁",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "夢に爰にあらぬ妻やうわ玉の夜半をはかなみをしか噌たん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鹿",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "〽いとはしようからすとてもうかるへし秋に夕かき世かなせは",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋夕",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "〽明渡る門日のいなはほの〳〵とな飛くかた原秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "秋田",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "ろし飛きの山のこのまに月に出ぬはたやみよひもひつくさむ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山月",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "更にけりをきそふ露も玉まれのこすのかほのた夜半の月歌",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "四月",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "よとゝもに関吹こゆるなくれを月にきくなりすまのうら人",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "関月",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "かつらきやまか名残はおをさりに畳も岩橋の夜かの月かけ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "橋月",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "吹にけり秋なき波の花もおを月に立そふ夜半のうし風",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦月",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "九重の庭に八千代をつむ菊の菊の露もやいとゝ玉をしくらし",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "角",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "秋風もお見たももほす故郷にいまや多らちめ良うつらん",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "擣衣",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "〽いつらついつみしに梨も霧立てかたりそき秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "其",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "そめやりぬ恩のもりのうす紅葉おくゆかしくも打しくれつゝ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "杜紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "新田川かにまつ木々のかうにしきかなはへ波のたゝむとて見る",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "川紅葉",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "書かねとてとゝまゝなくにゆく秋の見ちの芝草しもまかふ也",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "暮秋",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "村しくれふるつさむくならの葉の名にかふみやも冬はきにけり",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "時雨",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "山里にもみりぬみ分人とはゝあらしをさむみ和ふとこたへ舞",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "落葉",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "夜もすかゝさへしかき梨はとけに遣り霜のふりはのあかぬ朝けに",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霜",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "〽冬さむ見霜もふるえの花の露にかりの涙やこほりそふらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寒草",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "かさゝきのかけたる橋やこれならん霜さへ和たる夜半の月影",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冬月",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "さかた川袖つく水も行おやみ氷そかゝるまきのつきはし",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "ひろふともしはしはきえし霰さへこほりてたまる玉さゝのうへ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霰",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "〽明かたは月もかたみのうら風に猶友したふ千鳥なく也",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "千馬",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "一池水に氷の関やへたつらんつかはぬをしの声のさこゆる",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水鳥",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "ふるほともあさちにまし気さく花のなひくとそみかそ朝の初方",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浅雪",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "あらましもつもり〳〵てしら雪のふかき見ちにや跡をつけなん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "源香",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "〽神もそまうつき弓をし返しこたふ声計は心ひくらむ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神楽",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "いまも猶さかのゝきゝすねにそなく代々の御狩の跡や忘れぬ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鷹将",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "うすけふ梨出ひくをみれに雨雲のよそにもしるき山領の炭竈",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "炭竈",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "ゆく年も暮なはなけの花の色うつか日数もさのみおしまし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "歳暮",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "人しれぬ袖のなかにもたまり水ありとやこゝに月やとるらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄月恋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "おもへともむなしき空にゆく雲のきてもはれぬは心なりけり",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "寄雲恋",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "此節も又いまつらにあすか風身にのこしみて吹や過なん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二風々",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "こよひしも雨はふわきぬおなしくはとやかし人のさこそぬるとも",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二雨々",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "おくおはあたりはあたりのあまなれと結へは草のなひさやはれぬ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "々露々",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "いつよりかおもふにけらんかへせ山中なる川そ神にふかるゝ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二山々",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "焼はしもあたちの原にさら又ぬうきくろつかや独雨とらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二原々",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "かたるてふ事はなからのわし柱くちぬうき名のなにとたつらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "々橋々",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "よひ〳〵に誰ゆへならぬ関もりをかこつ身とてもいやはねらるゝ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ニ関々",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "和たすこのそこわかとなく流木のひかるゝしほそからきおも飛しる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ニ木々",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "契りたにかのすは心にかたとらましよしやうらみしもすの草くき",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二草々",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "〽羽かはす実はしらてむらき共雨つなはかりにさはきなれつゝ",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "々鳥々",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "しゝさりき契もうちに里のほのとかめし声をかきりやとは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "こ歎々",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "つゝまれぬ物にそ有ける心さへくたけておつか袖の白玉",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二玉々",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "おもひのみますみの鏡てにとれはかけもとまらすこともかはさす",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "々鏡ら",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "さても又いかにてゆへき夢とたにしらぬ枕をたのむはかなさ",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "ニ枕〻",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "うきなからかくてふかきのより衣おとかしほれぬ色にみえれん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "み衣に",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "いはまたかこなたかなたにかけつらんうきかたゑのそゆるちさりを",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "々糸々",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "〽おもひ絶ぬ今はちきりも秋の書させるふしなきねのみなかれて",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二虫々",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "かきわなき我ねさめかな暁其遊ふつけ鳥は八声なくなり",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首暁鶏ね",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "ふ髪にけりいら世の霜をかさね遣んかけもよは飛も多かきこの松",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "雑十首暁鶏ね",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "すくなれと窓の呉竹ふしておもひかきてもまなふ去きしまのた",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "竹",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "やとしめてすむ人かたし山ふかみことゝふさてのとはあれとも",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "山家",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "身を秋のかわなる庵になかめつゝ山田もるてふしほりにそすむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田家",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "暮るま方こへつる顔も多かし山ふもとの原に今宵かもねむ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "旅",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "一雲の上に知りの浦つる所畳てかよふも殿かき御代のためしそ",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浦鶴",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "かすかなる庭のをしへもしるふかなたえたるをつく道につかへて",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "述懐",
   "kotobagaki": ""
  },
  {
   "seq": "98",
   "text": "五変ひの諸に四代へて今色丈あへるをあふく道につかへて",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "神祇",
   "kotobagaki": ""
  },
  {
   "seq": "99",
   "text": "我君のめ梨や千世のありよすにあつめてけりかやまとことの葉",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-733908",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "祝",
   "kotobagaki": ""
  }
 ],
